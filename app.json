{
  "expo": {
    "name": "틈새번호",
    "slug": "lotto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lotto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.qova.teumsae"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B64DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qova.teumsae"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "lang": "ko"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B64DA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "27b2170d-1b02-4098-b19c-448afad41fdd"
      }
    },
    "owner": "aborts.403"
  }
}
